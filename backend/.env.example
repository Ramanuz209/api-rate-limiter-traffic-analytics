# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / PostgreSQL / SQLite)
# Option A: MySQL (XAMPP default)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rate_limiter_db

# Option B: PostgreSQL (Render or Supabase)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true

# Redis Configuration (Optional - has automatic in-memory fallback)
# REDIS_URL=redis://default:password@host:port
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
